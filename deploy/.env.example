# Salin menjadi deploy/.env lalu isi semua nilai.
# PENTING: simpan salinan file .env ini di tempat aman (terpisah dari server).
# Tanpa APP_ENCRYPTION_KEY yang sama, license key & password perangkat di backup TIDAK BISA dibuka.

# Domain aplikasi (DNS A record harus sudah mengarah ke IP server)
DOMAIN=manpro.perusahaan.co.id

# Password database (buat acak dan panjang)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# String acak 64 karakter hex. Buat dengan:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# Akun Super Admin pertama (dipakai saat menjalankan seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Backup
BACKUP_DIR=/var/backups/manpro
BACKUP_KEEP_DAYS=14

# Zona waktu kerja untuk rekap per hari (WIB = +07:00, WITA = +08:00, WIT = +09:00)
APP_TZ_OFFSET=+07:00
