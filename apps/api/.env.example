NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root@localhost:3306/2026_manpro
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
REDIS_URL=redis://localhost:6379
# Kunci enkripsi data rahasia (64 karakter hex). JANGAN diganti setelah ada data, data lama tidak bisa dibuka.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
STORAGE_DIR=./storage
# Zona waktu kerja untuk rekap per hari (WIB = +07:00, WITA = +08:00, WIT = +09:00)
APP_TZ_OFFSET=+07:00
# Jalankan worker queue di proses yang sama dengan API (true untuk development)
RUN_WORKER=true
